		end,
	}):AddColorPicker("crosshairtextcolor", {
		Default = Color3.new(1, 1, 1),
		Title = "Text Color",
		Callback = function(Value)
			cursor.Text.NameColor = Value
		end,
	})

	CrosshairGroup:AddSlider("crosshairlogooffset", {
		Text = "Logo Fade Offset",
		Default = 0,
		Min = 0,
		Max = 5,
		Rounding = 1,
		Callback = function(State)
			cursor.Text.LogoFadingOffset = State
		end,
	})

	-- Crosshair drawings (original logic)
	local lines = {}
	local outline = cheat.utility.new_drawing("Square", {
		Visible = true,
		Size = _Vector2new(4, 4),
		Color = Color3.fromRGB(0, 0, 0),
		Filled = true,
		ZIndex = 1,
		Transparency = 1,
	})
	local dot = cheat.utility.new_drawing("Square", {
		Visible = true,
		Size = _Vector2new(2, 2),
		Color = cursor.Color,
		Filled = true,
		ZIndex = 2,
		Transparency = 1,
	})
	local logotext = cheat.utility.new_drawing("Text", {
		Visible = false,
		Font = cursor.Font,
		Size = 13,
		Color = Color3.fromRGB(138, 128, 255),
		ZIndex = 3,
		Transparency = 1,
		Text = "NEXUS",
		Center = true,
		Outline = true,
	})

	for i = 1, 4 do
		local line_outline = cheat.utility.new_drawing("Line", {
			Visible = true,
			From = _Vector2new(200, 500),
			To = _Vector2new(200, 500),
			Color = Color3.fromRGB(0, 0, 0),
			Thickness = cursor.Thickness + 2.5,
			ZIndex = 1,
			Transparency = 1,
		})
		local line = cheat.utility.new_drawing("Line", {
			Visible = true,
			From = _Vector2new(200, 500),
			To = _Vector2new(200, 500),
			Color = cursor.Color,
			Thickness = cursor.Thickness,
			ZIndex = 2,
			Transparency = 1,
		})
		local naziline = cheat.utility.new_drawing("Line", {
			Visible = true,
			From = _Vector2new(200, 500),
			To = _Vector2new(200, 500),
			Color = cursor.Color,
			Thickness = cursor.Thickness,
			ZIndex = 2,
			Transparency = 1,
		})
		lines[i] = { line, line_outline, naziline }
	end

	local angle = 0
	local transp = 0
	local reverse = false
	local function setreverse(value)
		if reverse ~= value then
			reverse = value
		end
	end

	local pos, rainbow, rotationdegree, color = Vector2.zero, 0, 0, Color3.new()
	local math_cos, math_atan, math_pi, math_sin = math.cos, math.atan, math.pi, math.sin
	local function DEG2RAD(x)
		return x * math_pi / 180
	end
	local function RAD2DEG(x)
		return x * 180 / math_pi
	end

	cheat.utility.new_renderstepped(LPH_NO_VIRTUALIZE(function(delta)
		if cursor.Enabled then
			rainbow = rainbow + (delta * 0.5)
			if rainbow > 1.0 then
				rainbow = 0.0
			end
			color = Color3.fromHSV(rainbow, 1, 1)
			if cursor.CustomPos then
				pos = cursor.Position
			else
				if UserInputService.TouchEnabled then
					pos = (Camera and Camera.ViewportSize or Vector2.zero) * 0.5
				else
					local ok, loc = pcall(UserInputService.GetMouseLocation, UserInputService)
					pos = ok and typeof(loc) == "Vector2" and loc or (Camera and Camera.ViewportSize or Vector2.zero) * 0.5
				end
				end
			end
			if cursor.rainbow then
				color = Color3.fromHSV(rainbow, 1, 1)
			else
				color = cursor.Color
			end
			if transp <= 1.5 + cursor.Text.LogoFadingOffset and not reverse then
				transp = transp + (((cursor.Speed == 0 and 1 or cursor.Speed) * 10) * delta)
				if transp >= 1.5 + cursor.Text.LogoFadingOffset then
					setreverse(true)
				end
			elseif reverse then
				transp = transp - (((cursor.Speed == 0 and 1 or cursor.Speed) * 10) * delta)
				if transp <= 0 - cursor.Text.LogoFadingOffset then
					setreverse(false)
				end
			end
			logotext.Position = _Vector2new(pos.X, (pos + _Vector2new(0, cursor.Radius + 5)).Y)
			logotext.Transparency = transp
			logotext.Visible = cursor.Text.Logo
			logotext.Color = cursor.Text.LogoColor
			logotext.Font = cursor.Font

			if cursor.sussy then
				local frametime = delta
				local a = cursor.Radius - 10
				local gamma = math_atan(a / a)
				if rotationdegree >= 90 then
					rotationdegree = 0
				end
				for i = 1, 4 do
					local p_0 = (a * math_sin(DEG2RAD(rotationdegree + (i * 90))))
					local p_1 = (a * math_cos(DEG2RAD(rotationdegree + (i * 90))))
					local p_2 = ((a / math_cos(gamma)) * math_sin(DEG2RAD(rotationdegree + (i * 90) + RAD2DEG(gamma))))
					local p_3 = ((a / math_cos(gamma)) * math_cos(DEG2RAD(rotationdegree + (i * 90) + RAD2DEG(gamma))))
					lines[i][1].From = _Vector2new(pos.X, pos.Y)
					lines[i][1].To = _Vector2new(pos.X + p_0, pos.Y - p_1)
					lines[i][1].Color = color
					lines[i][1].Thickness = cursor.Thickness
					lines[i][1].Visible = true
					lines[i][3].From = _Vector2new(pos.X + p_0, pos.Y - p_1)
					lines[i][3].To = _Vector2new(pos.X + p_2, pos.Y - p_3)
					lines[i][3].Color = color
					lines[i][3].Thickness = cursor.Thickness
					lines[i][3].Visible = true
				end
				rotationdegree = rotationdegree + ((cursor.Speed * frametime) * 1000)
			else
				angle = (cursor.Speed == 0 and 0 or angle + ((cursor.Speed * 10) * delta))
				if angle >= 90 then
					angle = 0
				end
				dot.Visible = cursor.Dot
				dot.Color = color
				dot.Position = _Vector2new(pos.X - 1, pos.Y - 1)
				outline.Visible = cursor.Outline and cursor.Dot
				outline.Position = _Vector2new(pos.X - 2, pos.Y - 2)

				for index, line in pairs(lines) do
					local x, y = {}, {}
					local x1, y1 = {}, {}
					if cursor.Resize then
						x = {
							pos.X
								+ (math.cos(angle + (index * (math.pi / 2))) * (cursor.Radius + ((cursor.Radius * math.sin(angle)) / 9))),
							pos.X
								+ (math.cos(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20)
									- (cursor.TheGap and (((cursor.Radius - 20) * math.cos(angle)) / 4) or (((cursor.Radius - 20) * math.cos(angle)) - 4)))),
						}
						y = {
							pos.Y
								+ (math.sin(angle + (index * (math.pi / 2))) * (cursor.Radius + ((cursor.Radius * math.sin(angle)) / 9))),
							pos.Y
								+ (math.sin(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20)
									- (cursor.TheGap and (((cursor.Radius - 20) * math.cos(angle)) / 4) or (((cursor.Radius - 20) * math.cos(angle)) - 4)))),
						}
						x1 = {
							pos.X + (math.cos(angle + (index * (math.pi / 2))) * (cursor.Radius + 1)),
							pos.X
								+ (math.cos(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20 + 1)
									- (cursor.TheGap and ((cursor.Radius - 20 + 1) / cursor.Gap) or ((cursor.Radius - 20 + 1) - cursor.Gap)))),
						}
						y1 = {
							pos.Y + (math.sin(angle + (index * (math.pi / 2))) * (cursor.Radius + 1)),
							pos.Y
								+ (math.sin(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20 + 1)
									- (cursor.TheGap and ((cursor.Radius - 20 + 1) / cursor.Gap) or ((cursor.Radius - 20 + 1) - cursor.Gap)))),
						}
					else
						x = {
							pos.X + (math.cos(angle + (index * (math.pi / 2))) * (cursor.Radius)),
							pos.X
								+ (math.cos(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20)
									- (cursor.TheGap and ((cursor.Radius - 20) / cursor.Gap) or ((cursor.Radius - 20) - cursor.Gap)))),
						}
						y = {
							pos.Y + (math.sin(angle + (index * (math.pi / 2))) * (cursor.Radius)),
							pos.Y
								+ (math.sin(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20)
									- (cursor.TheGap and ((cursor.Radius - 20) / cursor.Gap) or ((cursor.Radius - 20) - cursor.Gap)))),
						}
						x1 = {
							pos.X + (math.cos(angle + (index * (math.pi / 2))) * (cursor.Radius + 1)),
							pos.X
								+ (math.cos(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20 + 1)
									- (cursor.TheGap and ((cursor.Radius - 20 + 1) / cursor.Gap) or ((cursor.Radius - 20 + 1) - cursor.Gap)))),
						}
						y1 = {
							pos.Y + (math.sin(angle + (index * (math.pi / 2))) * (cursor.Radius + 1)),
							pos.Y
								+ (math.sin(angle + (index * (math.pi / 2))) * ((cursor.Radius - 20 + 1)
									- (cursor.TheGap and ((cursor.Radius - 20 + 1) / cursor.Gap) or ((cursor.Radius - 20 + 1) - cursor.Gap)))),
						}
					end
					line[1].Visible = true
					line[1].Color = color
					line[1].From = _Vector2new(x[2], y[2])
					line[1].To = _Vector2new(x[1], y[1])
					line[1].Thickness = cursor.Thickness
					line[2].Visible = cursor.Outline
					line[2].From = _Vector2new(x1[2], y1[2])
					line[2].To = _Vector2new(x1[1], y1[1])
					line[2].Thickness = cursor.Thickness + 2.5
					line[3].Visible = false
				end
			end
		else
			dot.Visible = false
			outline.Visible = false
			logotext.Visible = false
			for index, line in pairs(lines) do
				line[1].Visible = false
				line[2].Visible = false
				line[3].Visible = false
			end
		end
	end))
end

-- ====================== SPEEDHACK ======================
do
	local SpeedGroup = Tabs.Misc:AddLeftGroupbox("Speedhack")
	local bhop_enabled, speed = false, 55
	local forcesprint = false

	SpeedGroup:AddToggle("speedhack_forcesprint", {
		Text = "Force Sprint",
		Default = false,
		Callback = function(first)
			forcesprint = first
		end,
	})

	SpeedGroup:AddToggle("speedhack_enabled", {
		Text = "Speedhack Enabled",
		Default = false,
		Callback = function(first)
			bhop_enabled = first
		end,
	})

	SpeedGroup:AddSlider("speedhack_speed", {
		Text = "Speed",
		Default = 55,
		Min = 55,
		Max = 70,
		Rounding = 0,
		Suffix = "sps",
		Callback = function(State)
			speed = State
		end,
	})

	local niga, wtf = speed, 0
	local middle = trident.middlepart
	if not middle then
		resolveTrident()
		middle = trident.middlepart
	end

	local refreshClock = 0
	cheat.utility.new_renderstepped(LPH_JIT_MAX(function(delta)
		refreshClock += delta
		if refreshClock >= 1 or not middle or not middle.Parent then
			refreshClock = 0
			resolveTrident()
			middle = trident.middlepart
		end

		if bhop_enabled and middle
            and _IsKeyDown(UserInputService, Enum.KeyCode.C)
            and _IsKeyDown(UserInputService, Enum.KeyCode.LeftShift) then
			local cameralook = Camera.CFrame.LookVector
			cameralook = _Vector3new(cameralook.X, 0, cameralook.Z)
			local direction = Vector3.zero
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.W) and direction + cameralook or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.S) and direction - cameralook or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.D)
					and direction + _Vector3new(-cameralook.Z, 0, cameralook.X)
				or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.A)
					and direction + _Vector3new(cameralook.Z, 0, -cameralook.X)
				or direction
			if not (direction == Vector3.zero) then
				direction = direction.Unit
			end
			niga = math.clamp(niga - delta * 20, 17, speed)
			if wtf == 0 then
				middle.CFrame = middle.CFrame + _Vector3new(0, 6.5, 0)
			end
			middle.AssemblyLinearVelocity = _Vector3new(direction.X * niga, wtf < 0.85 and 0 or -7, direction.Z * niga)
			wtf = wtf + delta
		else
			if forcesprint and middle then
				local cameralook = Camera.CFrame.LookVector
				cameralook = _Vector3new(cameralook.X, 0, cameralook.Z)
				local direction = Vector3.zero
				direction = _IsKeyDown(UserInputService, Enum.KeyCode.W) and direction + cameralook or direction
				direction = _IsKeyDown(UserInputService, Enum.KeyCode.S) and direction - cameralook or direction
				direction = _IsKeyDown(UserInputService, Enum.KeyCode.D)
						and direction + _Vector3new(-cameralook.Z, 0, cameralook.X)
					or direction
				direction = _IsKeyDown(UserInputService, Enum.KeyCode.A)
						and direction + _Vector3new(cameralook.Z, 0, -cameralook.X)
					or direction
				if not (direction == Vector3.zero) then
					direction = direction.Unit
				end
				middle.AssemblyLinearVelocity =
					_Vector3new(direction.X * 18, middle.AssemblyLinearVelocity.Y, direction.Z * 18)
			end
			niga = speed
			wtf = 0
		end
	end))
end

-- ====================== EXPLOITS (Freecam / Long Neck / Fake Crouch) ======================
do
	local ExploitGroup = Tabs.Misc:AddLeftGroupbox("Exploits")
	local enabled, speed = false, 55
	local fakecrouch_timer = tick()

	ExploitGroup:AddToggle("fakecrouch", {
		Text = "Fake Crouch",
		Default = false,
		Callback = function(first)
			aimbot.silentwalk = first
		end,
	}):AddKeyPicker("silentwalk_bind", {
		Default = "None",
		SyncToggleState = true,
		Mode = "Toggle",
		Text = "Fake Crouch",
	})

	local freecamoffset = Vector3.zero
	local middle, bottom, top, originalprismcframe, pos

	local function refreshCharacterParts()
		resolveTrident()
		middle = trident.middlepart
		local const = workspace:FindFirstChild("Const")
		local ignore = const and const:FindFirstChild("Ignore")
		local localCharacter = ignore and ignore:FindFirstChild("LocalCharacter")
		bottom = localCharacter and localCharacter:FindFirstChild("Bottom")
		top = localCharacter and localCharacter:FindFirstChild("Top")
		local prism = top and top:FindFirstChild("Prism1")
		originalprismcframe = prism and prism.CFrame or originalprismcframe
		pos = middle and middle.CFrame or pos
		return middle ~= nil
	end

	refreshCharacterParts()

	ExploitGroup:AddToggle("longneck", {
		Text = "Long Neck",
		Default = false,
		Callback = function(first)
			if not top or not top:FindFirstChild("Prism1") or not originalprismcframe then
				refreshCharacterParts()
			end
			local prism = top and top:FindFirstChild("Prism1")
			if prism and originalprismcframe then
				prism.CFrame = first and originalprismcframe - Vector3.yAxis * 5 or originalprismcframe
			end
		end,
	}):AddKeyPicker("longneck_bind", {
		Default = "None",
		SyncToggleState = true,
		Mode = "Toggle",
		Text = "Long Neck",
	})

	ExploitGroup:AddToggle("freecam_enabled", {
		Text = "Freecam Enabled",
		Default = false,
		Callback = function(first)
			enabled = first
			if not middle or not bottom or not top then
				refreshCharacterParts()
			end
			if middle then middle.CanCollide = not first end
			if bottom then bottom.CanCollide = not first end
			if top then top.CanCollide = not first end
		end,
	}):AddKeyPicker("freecam_bind", {
		Default = "None",
		SyncToggleState = true,
		Mode = "Toggle",
		Text = "Freecam",
	})

	ExploitGroup:AddSlider("freecam_speed", {
		Text = "Speed",
		Default = 10,
		Min = 1,
		Max = 300,
		Rounding = 0,
		Suffix = "sps",
		Callback = function(State)
			speed = State
		end,
	})

	local refreshClock = 0
	cheat.utility.new_heartbeat(LPH_JIT_MAX(function(delta)
		refreshClock += delta
		if refreshClock >= 1 or not middle or not middle.Parent then
			refreshClock = 0
			refreshCharacterParts()
		end

		if aimbot.silentwalk and tick() - fakecrouch_timer >= 0.15 then
			if trident.tcp then
				trident.tcp:FireServer(2, true)
			end
			fakecrouch_timer = tick()
		end
		if enabled and middle then
			middle.CFrame = pos
			if middle then
				local humanoid=LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
				local direction=humanoid and humanoid.MoveDirection or Vector3.zero
				if direction ~= Vector3.zero then
					direction = direction.Unit
				end
				freecamoffset = freecamoffset + (direction * delta * speed)
				middle.CFrame = pos + freecamoffset
				middle.AssemblyLinearVelocity = Vector3.zero
			end
		elseif middle then
			freecamoffset = Vector3.zero
			pos = middle.CFrame
		end
	end))
end

-- ====================== ATV FLY ======================
do
	local ATVGroup = Tabs.Misc:AddRightGroupbox("ATV Fly")
	local carfly_enabled, speed, accel, upspeed = false, 55, 100, 15

	ATVGroup:AddToggle("carfly_enabled", {
		Text = "Car Fly Enabled",
		Default = false,
		Callback = function(first)
			carfly_enabled = first
		end,
	}):AddKeyPicker("carfly_bind", {
		Default = "None",
		SyncToggleState = true,
		Mode = "Toggle",
		Text = "Car Fly",
	})

	ATVGroup:AddSlider("carfly_speed", {
		Text = "Speed",
		Default = 150,
		Min = 50,
		Max = 300,
		Rounding = 0,
		Suffix = "sps",
		Callback = function(State)
			speed = State
		end,
	})

	ATVGroup:AddSlider("carfly_upspeed", {
		Text = "Up Speed",
		Default = 15,
		Min = 5,
		Max = 100,
		Rounding = 0,
		Suffix = "sps",
		Callback = function(State)
			upspeed = State
		end,
	})

	ATVGroup:AddSlider("carfly_accel", {
		Text = "Acceleration",
		Default = 100,
		Min = 10,
		Max = 300,
		Rounding = 0,
		Suffix = "sps",
		Callback = function(State)
			accel = State
		end,
	})

	ATVGroup:AddLabel("Hold V to go up")
	ATVGroup:AddLabel("Hold B to go down")

	local car, dist = nil, 50
	local findcar = function()
		car, dist = nil, 50
		for i, v in pairs(workspace:GetChildren()) do
			if v:FindFirstChild("Seat") and v:FindFirstChild("Frame") then
				if trident.middlepart and (v.Frame.Position - trident.middlepart.Position).Magnitude < dist then
					car = v
					dist = trident.middlepart and (v.Frame.Position - trident.middlepart.Position).Magnitude or dist
				end
			end
		end
	end
	if trident.middlepart then
		findcar()
	end

	local buildup = 0
	local lastdir = _Vector3new(1, 0, 0)

	local carRefresh = 0
	cheat.utility.new_renderstepped(LPH_JIT_MAX(function(delta)
		carRefresh += delta
		if carRefresh >= 0.5 or not car or not car.Parent then
			carRefresh = 0
			findcar()
		end

		if
			carfly_enabled
			and car
			and car:FindFirstChild("Frame")
			and (car.Frame.CFrame.p - Camera.CFrame.p).Magnitude <= 50
		then
			local cameralook = Camera.CFrame.LookVector
			cameralook = _Vector3new(cameralook.X, 0, cameralook.Z)
			local direction = Vector3.zero
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.W) and direction + cameralook or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.S) and direction - cameralook or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.D)
					and direction + _Vector3new(-cameralook.Z, 0, cameralook.X)
				or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.A)
					and direction + _Vector3new(cameralook.Z, 0, -cameralook.X)
				or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.V) and direction + Vector3.yAxis or direction
			direction = _IsKeyDown(UserInputService, Enum.KeyCode.B) and direction - Vector3.yAxis or direction
			if direction ~= Vector3.zero then
				direction = direction.Unit
				if direction ~= Vector3.yAxis and -direction ~= Vector3.yAxis then
					buildup = math.clamp(buildup + delta * accel, 0, speed)
					lastdir = direction
				end
			else
				direction = lastdir
				buildup = math.clamp(buildup - delta * 150, 0, speed)
			end
			for i, v in pairs(car:GetChildren()) do
				v.AssemblyLinearVelocity = _Vector3new(direction.X * buildup, direction.Y * upspeed, direction.Z * buildup)
			end
		elseif not car or (car and car:FindFirstChild("Frame") and (car.Frame.CFrame.p - Camera.CFrame.p).Magnitude > 50) then
			findcar()
			buildup = 0
		else
			buildup = 0
		end
	end))
end

-- ====================== CHAT TOOLS ======================
do
	local ChatGroup = Tabs.Misc:AddRightGroupbox("Chat Tools")
	local enabled = false
	local delayTime = 1.25
	local message = "NEXUS"
	local clock = 0

	ChatGroup:AddToggle("chat_spam_enabled",{
		Text="Cycle Message",Default=false,Callback=function(v) enabled=v end
	})

	ChatGroup:AddInput("chat_spam_text",{
		Text="Message",Default="NEXUS",Placeholder="Text",Finished=false,
		Callback=function(v) message=tostring(v or "NEXUS") end
	})

	ChatGroup:AddSlider("chat_spam_delay",{
		Text="Interval",Default=1.25,Min=0.25,Max=10,Rounding=2,Suffix="s",
		Callback=function(v) delayTime=v end
	})

	cheat.utility.new_heartbeat(function(dt)
		if not enabled or not trident.tcp then return end
		clock += dt
		if clock >= delayTime then
			clock=0
			pcall(function()
				trident.tcp:FireServer(23,message,"Global")
			end)
		end
	end)
end

-- ====================== UI SETTINGS / MOBILE ======================
do
	local UIGroup = Tabs.Config:AddLeftGroupbox("UI Settings")
	UIGroup:AddToggle("keybindshoww", {Text="Show Keybinds",Default=false,Callback=function(v) if Library.KeybindFrame then Library.KeybindFrame.Visible=v end end})
	UIGroup:AddToggle("mobile_quickbar", {Text="Mobile Quick Bar",Default=UserInputService.TouchEnabled,Callback=function(v) if GLOBAL_ENV.__TS_MOBILE_GUI then GLOBAL_ENV.__TS_MOBILE_GUI.Enabled=v end end})
	UIGroup:AddButton({Text="Toggle Window",Func=function() pcall(function() Library:Toggle() end) end})
	UIGroup:AddLabel(UserInputService.TouchEnabled and "Touch device detected" or "Keyboard / mouse device detected")
	UIGroup:AddLabel("ESP tracker: continuous rescan + respawn recovery")
end

do
	if UserInputService.TouchEnabled then
		local old = GLOBAL_ENV.__TS_MOBILE_GUI
		if old then pcall(function() old:Destroy() end) end
		local gui=Instance.new("ScreenGui")
		gui.Name="TSMobileQuickBar"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=true; gui.Parent=game:GetService("CoreGui")
		GLOBAL_ENV.__TS_MOBILE_GUI=gui
		local frame=Instance.new("Frame"); frame.BackgroundTransparency=1; frame.Size=UDim2.fromOffset(82,440); frame.Position=UDim2.new(1,-96,0.22,0); frame.Parent=gui
		local list=Instance.new("UIListLayout"); list.Padding=UDim.new(0,8); list.HorizontalAlignment=Enum.HorizontalAlignment.Center; list.Parent=frame
		local function btn(text,callback)
			local b=Instance.new("TextButton"); b.Size=UDim2.fromOffset(72,48); b.Text=text; b.TextSize=13; b.Font=Enum.Font.GothamBold; b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(9,18,28); b.BackgroundTransparency=0.08; b.AutoButtonColor=true; b.Parent=frame
			local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,12); c.Parent=b; local s=Instance.new("UIStroke"); s.Thickness=1; s.Transparency=0.3; s.Color=Color3.fromRGB(80,210,255); s.Parent=b
			b.Activated:Connect(callback); return b
		end
		btn("MENU",function() pcall(function() Library:Toggle() end) end)
		btn("ESP",function() local t=Toggles.espswitch; if t and t.SetValue then pcall(function() t:SetValue(not t.Value) end) end end)
		btn("AIM",function() local t=Toggles.aimbot_enabled; if t and t.SetValue then pcall(function() t:SetValue(not t.Value) end) end end)
		local function toggle(name)
			local t=Toggles[name]
			if t and t.SetValue then pcall(function() t:SetValue(not t.Value) end) end
		end
		btn("CHAMS",function() toggle("espchams") end)
		btn("SPEED",function() toggle("speedhack_enabled") end)
		btn("FREECAM",function() toggle("freecam_enabled") end)
		btn("NECK",function() toggle("longneck") end)
		btn("CAR",function() toggle("carfly_enabled") end)
	end
end

-- ====================== THEME + SAVE MANAGER ======================
local ThemeGroup = Tabs.Config:AddRightGroupbox("Theme")

if ThemeManager then
	pcall(function()
		ThemeManager:SetLibrary(Library)
		ThemeManager:SetFolder("nexus")
		ThemeManager:ApplyToGroupbox(ThemeGroup)
	end)
end

if SaveManager then
	pcall(function()
		SaveManager:SetLibrary(Library)
		SaveManager:IgnoreThemeSettings()
		SaveManager:SetFolder("nexus")
		SaveManager:BuildConfigSection(Tabs.Config)
	end)
else
	pcall(function()
		Tabs.Config:AddLabel("Config manager unavailable; runtime remains active.")
	end)
end

-- Final
pcall(function() cheat.EspLibrary.load() end)

pcall(function()
	Library:Notify({
		Title = "NEXUS carregado",
		Description = UserInputService.TouchEnabled and "Trident Survival validado • layout mobile ativo." or "Trident Survival validado • layout desktop ativo.",
		Time = 4,
	})
end)

Library:OnUnload(function()
	pcall(function() if GLOBAL_ENV.__TS_MOBILE_GUI then GLOBAL_ENV.__TS_MOBILE_GUI:Destroy(); GLOBAL_ENV.__TS_MOBILE_GUI=nil end end)
	cheat.utility.unload()
	if cheat.EspLibrary and cheat.EspLibrary.__loaded then
		cheat.EspLibrary.unload()
	end
end)


