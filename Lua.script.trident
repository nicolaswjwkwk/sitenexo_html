-- free_trident.lua portado para Obsidian UI
-- Lógica do Trident Survival preservada | Interface: Obsidian

-- ====================== EXECUTOR COMPATIBILITY ======================
-- Keep optional executor-only optimizations from breaking the core UI.

local type_custom = typeof

local function identity(...)
    return ...
end

if type(LPH_JIT) ~= "function" then LPH_JIT = identity end
if type(LPH_JIT_MAX) ~= "function" then LPH_JIT_MAX = identity end
if type(LPH_NO_VIRTUALIZE) ~= "function" then LPH_NO_VIRTUALIZE = identity end
if type(LPH_NO_UPVALUES) ~= "function" then
    LPH_NO_UPVALUES = function(f)
        return function(...)
            return f(...)
        end
    end
end
if type(LPH_ENCSTR) ~= "function" then LPH_ENCSTR = identity end
if type(LPH_ENCNUM) ~= "function" then LPH_ENCNUM = identity end
if type(LPH_ENCFUNC) ~= "function" then
    LPH_ENCFUNC = function(func)
        return func
    end
end

-- ====================== ENVIRONMENT GATE ======================
-- Trident Survival current experience identifiers (verified from Roblox).
local TRIDENT_PLACE_ID = 13253735473
local TRIDENT_UNIVERSE_ID = 4620241901

local function reportEnvironmentMismatch()
    local detectedPlace = tonumber(game.PlaceId) or 0
    local detectedUniverse = tonumber(game.GameId) or 0
    local message = string.format(
        "[NEXUS][ENVIRONMENT BLOCKED] Este script/código pertence somente ao Trident Survival.\n" ..
        "Esperado: PlaceId=%d | UniverseId=%d\n" ..
        "Detectado: PlaceId=%d | UniverseId=%d\n" ..
        "O carregamento foi interrompido para evitar callbacks e referências incompatíveis.",
        TRIDENT_PLACE_ID,
        TRIDENT_UNIVERSE_ID,
        detectedPlace,
        detectedUniverse
    )

    pcall(function()
        if type(rconsolewarn) == "function" then
            rconsolewarn(message)
        end
    end)
    warn(message)
    error(message, 0)
end

local function isTridentEnvironment()
    local placeId = tonumber(game.PlaceId) or 0
    local universeId = tonumber(game.GameId) or 0

    -- Current Trident place is the authoritative gate. Universe is a
    -- secondary check for cases where Roblox reports the universe id first.
    return placeId == TRIDENT_PLACE_ID and universeId == TRIDENT_UNIVERSE_ID
end

if not isTridentEnvironment() then
    reportEnvironmentMismatch()
end

local function failStage(stage, detail)
    local message = string.format("[NEXUS][BOOT FAILED][%s] %s", tostring(stage), tostring(detail or "unknown error"))
    pcall(function()
        if type(rconsoleerr) == "function" then
            rconsoleerr(message)
        end
    end)
    warn(message)
    error(message, 0)
end

if type(LPH_CRASH) ~= "function" then
    LPH_CRASH = function()
        warn(debug.traceback())
    end
end

local cloneref_fn = type(cloneref) == "function" and cloneref or function(v)
    return v
end

-- ====================== CORE SERVICES ======================
-- Declare every runtime dependency before the dispatcher and helper cache.
-- The previous build used RunService/workspace/UserInputService before
-- declaring them, which stopped execution at the first Heartbeat access.
local Players = cloneref_fn(game:GetService("Players"))
local RunService = cloneref_fn(game:GetService("RunService"))
local workspace = cloneref_fn(game:GetService("Workspace"))
local Lighting = cloneref_fn(game:GetService("Lighting"))
local UserInputService = cloneref_fn(game:GetService("UserInputService"))
local GuiService = cloneref_fn(game:GetService("GuiService"))
local ReplicatedStorage = cloneref_fn(game:GetService("ReplicatedStorage"))
local HttpService = cloneref_fn(game:GetService("HttpService"))

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer and LocalPlayer:GetMouse() or nil
local Camera = workspace.CurrentCamera
local GuiInset = GuiService:GetGuiInset()

local function refreshRuntimeReferences()
    local current = workspace.CurrentCamera
    if current then
        Camera = current
    end
    if LocalPlayer and not Mouse then
        pcall(function() Mouse = LocalPlayer:GetMouse() end)
    end
    pcall(function() GuiInset = GuiService:GetGuiInset() end)
end

-- ====================== COMPATIBILITY / RUNTIME ======================
-- Keep optional game-specific discovery non-blocking. The previous build
-- the previous build downloaded external helper files before the UI existed, so an HTTP/JSON failure
-- could prevent the interface from ever being created.

local function safeHttpGet(url)
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(result) == "string" and #result > 0 then
        return result
    end
    return nil
end

local function safeLoadRemote(url)
    if type(loadstring) ~= "function" then
        return nil, "loadstring unavailable in this environment"
    end

    local source = safeHttpGet(url)
    if not source then
        return nil, "HTTP request failed"
    end

    local ok, fn = pcall(loadstring, source)
    if not ok or type(fn) ~= "function" then
        return nil, "loadstring failed"
    end

    local okRun, result = pcall(fn)
    if not okRun then
        return nil, tostring(result)
    end

    return result
end

local NEXUS_VERSION = "Trident"
local NEXUS_SHORT_NAME = "NEXUS"
local NEXUS_TITLE = "NEXUS Combat • Trident Survival"
local GLOBAL_ENV = (type(getgenv) == "function" and getgenv()) or _G

-- ====================== TRIDENT SURVIVAL BOOTSTRAP ======================
-- The original free_trident.lua waits for these three Trident-only references.
-- Keep the port strict: do not initialize the hub in unrelated games.
local function getTridentBootstrap()
    local const = workspace:FindFirstChild("Const")
    local ignore = const and const:FindFirstChild("Ignore")
    local localCharacter = ignore and ignore:FindFirstChild("LocalCharacter")
    local middle = localCharacter and localCharacter:FindFirstChild("Middle")

    local tcp = LocalPlayer and LocalPlayer:FindFirstChild("TCP")
    local shared = ReplicatedStorage and ReplicatedStorage:FindFirstChild("Shared")
    local entities = shared and shared:FindFirstChild("entities")
    local playerEntity = entities and entities:FindFirstChild("Player")
    local model = playerEntity and playerEntity:FindFirstChild("Model")

    return {
        localCharacter = localCharacter,
        middle = middle,
        bottom = localCharacter and localCharacter:FindFirstChild("Bottom") or nil,
        top = localCharacter and localCharacter:FindFirstChild("Top") or nil,
        prism = localCharacter and localCharacter:FindFirstChild("Top")
            and localCharacter.Top:FindFirstChild("Prism1") or nil,
        tcp = tcp,
        shared = shared,
        entities = entities,
        playerEntity = playerEntity,
        model = model,
        ready = middle ~= nil and tcp ~= nil and model ~= nil
    }
end

local trident_boot = getTridentBootstrap()

-- UI must not depend on game-internal discovery.
-- Missing/renamed Trident references are handled later by resolveTrident().
if not trident_boot.ready then
    warn("[NEXUS] Trident references not ready yet; loading UI first.")
end

-- Keep the camera reference current when Roblox recreates it.
pcall(function()
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        refreshRuntimeReferences()
    end)
end)

pcall(function()
    if LocalPlayer then
        LocalPlayer.CharacterAdded:Connect(function()
            task.defer(refreshRuntimeReferences)
        end)
    end
end)

-- ====================== OBSIDIAN UI ======================
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/"

local Library, ThemeManager, SaveManager
do
    local result, err = safeLoadRemote(repo .. "Library.lua")
    if type(result) ~= "table" then
        failStage("OBSIDIAN_LOAD", err or result)
    end

    Library = result

    local tm = safeLoadRemote(repo .. "addons/ThemeManager.lua")
    local sm = safeLoadRemote(repo .. "addons/SaveManager.lua")
    ThemeManager = type(tm) == "table" and tm or nil
    SaveManager = type(sm) == "table" and sm or nil
end

if type(Library.CreateWindow) ~= "function" then
    failStage("OBSIDIAN_API", "CreateWindow() não foi encontrado na versão carregada da biblioteca.")
end

local Options = Library.Options
local Toggles = Library.Toggles
if type(Options) ~= "table" or type(Toggles) ~= "table" then
    failStage("OBSIDIAN_STATE", "Library.Options/Toggles não estão disponíveis.")
end

Library.ForceCheckbox = false
Library.ShowToggleFrameInKeybinds = true
pcall(function() Library.NotifyOnError = true end)

local windowOk, Window = pcall(function()
    return Library:CreateWindow({
        Title = NEXUS_TITLE,
        Footer = "NEXUS • Advanced Combat / Visuals",
        Center = true,
        AutoShow = true,
        Resizable = true,
        MobileButtonsSide = "Right",
        ShowCustomCursor = true,
        NotifySide = "Right",
        AlwaysOnTop = true,
    })
end)
if not windowOk or not Window then
    failStage("CREATE_WINDOW", Window)
end

pcall(function()
	Window:SetAnimations({
		ToggleWindow = true,
		TabSwitch = true,
		Groupbox = true,
		Dropdown = true,
		KeyPicker = true,
	}, 0.16)
end)

local function addTabChecked(key, name, icon)
    local ok, tab = pcall(function()
        return Window:AddTab(name, icon)
    end)
    if not ok or not tab then
        failStage("ADD_TAB_" .. string.upper(tostring(key)), tab)
    end
    return tab
end

local Tabs = {
    Combat = addTabChecked("Combat", "Combat", "crosshair"),
    ESP = addTabChecked("ESP", "ESP", "eye"),
    Visuals = addTabChecked("Visuals", "Visuals", "palette"),
    Misc = addTabChecked("Misc", "Misc", "settings-2"),
    Config = addTabChecked("Config", "Config", "cog"),
}

-- ====================== CHEAT CORE ======================
local cheat = {
	Library = Library,
	Toggles = Toggles,
	Options = Options,
	ThemeManager = ThemeManager,
	SaveManager = SaveManager,
	connections = {
		heartbeats = {},
		renderstepped = {},
	},
	drawings = {},
	hooks = {},
}

cheat.utility = {}
do
	cheat.utility.new_heartbeat = function(func)
		local obj = {}
		cheat.connections.heartbeats[func] = func
		function obj:Disconnect()
			if func then
				cheat.connections.heartbeats[func] = nil
				func = nil
			end
		end
		return obj
	end

	cheat.utility.new_renderstepped = function(func)
		local obj = {}
		cheat.connections.renderstepped[func] = func
		function obj:Disconnect()
			if func then
				cheat.connections.renderstepped[func] = nil
				func = nil
			end
		end
		return obj
	end

	cheat.utility.new_drawing = function(drawobj, args)
		if not Drawing or type(Drawing.new) ~= "function" then
			return nil
		end

		local ok, obj = pcall(function()
			return Drawing.new(drawobj)
		end)
		if not ok or not obj then
			return nil
		end

		for i, v in pairs(args or {}) do
			pcall(function()
				obj[i] = v
			end)
		end

		cheat.drawings[obj] = obj
		return obj
	end

	cheat.utility.new_hook = function(f, newf, usecclosure)
		if type(hookfunction) ~= "function" or type(f) ~= "function" or type(newf) ~= "function" then
			warn("[NEXUS][HOOK] API indisponível; hook ignorado.")
			return nil
		end
		return LPH_NO_VIRTUALIZE(function()
			local old
			local handler = function(...)
				return newf(old, ...)
			end
			if usecclosure and type(newcclosure) == "function" then
				handler = newcclosure(handler)
			end
			local ok, result = pcall(function()
				old = hookfunction(f, handler)
				return old
			end)
			if not ok or type(result) ~= "function" then
				warn("[NEXUS][HOOK] Falha ao instalar hook: " .. tostring(result))
				return nil
			end
			cheat.hooks[f] = result
			return result
		end)()
	end

	local runtimeErrors = setmetatable({}, { __mode = "k" })

	local function runSafely(func, delta)
		local state = runtimeErrors[func]
		if state and state.disabledUntil and os.clock() < state.disabledUntil then
			return
		end

		local ok, err = xpcall(function()
			func(delta)
		end, function(e)
			local trace = type(debugLib.traceback) == "function" and debugLib.traceback() or "no traceback"
			return tostring(e) .. "\n" .. trace
		end)

		if ok then
			if state then
				state.errors = 0
				state.disabledUntil = nil
			end
			return
		end

		local now = os.clock()
		state = state or { errors = 0, windowStart = now, lastReport = 0 }
		runtimeErrors[func] = state

		if now - state.windowStart > 5 then
			state.windowStart = now
			state.errors = 0
		end

		state.errors += 1
		if state.errors == 1 or now - state.lastReport > 5 then
			state.lastReport = now
			warn("[NEXUS][RUNTIME] Callback isolado com erro: " .. tostring(err))
		end

		-- Avoid a broken callback consuming a full frame every heartbeat/render step.
		if state.errors >= 3 then
			state.disabledUntil = now + 10
			warn("[NEXUS][RUNTIME] Callback temporariamente pausado por falhas repetidas (10s).")
		end
	end

	local connection
	connection = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(delta)
		for _, func in pairs(cheat.connections.heartbeats) do
			runSafely(func, delta)
		end
	end))

	local connection1
	connection1 = RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function(delta)
		for _, func in pairs(cheat.connections.renderstepped) do
			runSafely(func, delta)
		end
	end))

	cheat.utility.unload = function()
		connection:Disconnect()
		connection1:Disconnect()
		for key, _ in pairs(cheat.connections.heartbeats) do
			cheat.connections.heartbeats[key] = nil
		end
		for key, _ in pairs(cheat.connections.renderstepped) do
			cheat.connections.renderstepped[key] = nil
		end
		for key, drawing in pairs(cheat.drawings) do
			pcall(function() drawing:Remove() end)
			cheat.drawings[key] = nil
		end
		pcall(function() if cheat.fovGui then cheat.fovGui:Destroy(); cheat.fovGui=nil end end)
		for hooked, original in pairs(cheat.hooks) do
			pcall(function()
				if type(original) == "function" and type(hookfunction) == "function" then
					local restore = type(clonefunction) == "function" and clonefunction(original) or original
					hookfunction(hooked, restore)
				elseif type(original) == "table" and type(hookmetamethod) == "function" and type(original.instance) ~= "nil" then
					local restore = type(clonefunction) == "function" and clonefunction(original.func) or original.func
					hookmetamethod(original.instance, original.metamethod, restore)
				end
			end)
		end
	end
end

-- Helpers originais
local _CFramenew = CFrame.new
local _Vector2new = Vector2.new
local _Vector3new = Vector3.new
local _IsDescendantOf = game.IsDescendantOf
local _FindFirstChild = game.FindFirstChild
local _FindFirstChildOfClass = game.FindFirstChildOfClass
local _Raycast = workspace.Raycast
local _IsKeyDown = UserInputService.IsKeyDown
local _WorldToViewportPoint = function(_, world)
	local cam = workspace.CurrentCamera or Camera
	if not cam then
		return Vector3.zero, false
	end
	return cam:WorldToViewportPoint(world)
end
local _Vector3zeromin = Vector3.zero.Min
local _Vector2zeromin = Vector2.zero.Min
local _Vector3zeromax = Vector3.zero.Max
local _Vector2zeromax = Vector2.zero.Max
local _IsA = game.IsA
local tablecreate = table.create
local mathfloor = math.floor
local mathround = math.round
local mathclamp = math.clamp
local tostring = tostring
local unpack = unpack
local debugLib = type(debug) == "table" and debug or {}
local getupvalues = type(debugLib.getupvalues) == "function" and debugLib.getupvalues or nil
local getupvalue = type(debugLib.getupvalue) == "function" and debugLib.getupvalue or nil
local setupvalue = type(debugLib.setupvalue) == "function" and debugLib.setupvalue or nil
local getconstants = type(debugLib.getconstants) == "function" and debugLib.getconstants or nil
local getconstant = type(debugLib.getconstant) == "function" and debugLib.getconstant or nil
local setconstant = type(debugLib.setconstant) == "function" and debugLib.setconstant or nil
local getstack = type(debugLib.getstack) == "function" and debugLib.getstack or nil
local setstack = type(debugLib.setstack) == "function" and debugLib.setstack or nil
local getinfo = type(debugLib.getinfo) == "function" and debugLib.getinfo or nil
local rawget = rawget

local function safeGetUpvalue(fn, index)
	if type(fn) ~= "function" or type(getupvalue) ~= "function" then
		return nil
	end

	local ok, a, b = pcall(getupvalue, fn, index)
	if not ok then
		return nil
	end

	-- Standard Lua returns (name, value); several executors return only value.
	return b ~= nil and b or a
end

-- Trident setup (non-blocking / executor-safe)
-- The old version used a repeat/until gate here. If one of the game
-- internals was renamed or had not replicated yet, the script stopped
-- after creating the window, leaving every tab empty.
local trident = {
	loaded = trident_boot.ready,
	lastpos = nil,
	middlepart = trident_boot.middle,
	bottompart = trident_boot.bottom,
	toppart = trident_boot.top,
	prism = trident_boot.prism,
	tcp = trident_boot.tcp,
	original_model = trident_boot.model,
	shared = trident_boot.shared,
	entities = trident_boot.entities,
	player_entity = trident_boot.playerEntity,
	available = trident_boot.ready,
	ready = trident_boot.ready,
	services = {
		Workspace = workspace,
		Players = Players,
		RunService = RunService,
		Lighting = Lighting,
		UserInputService = UserInputService,
		HttpService = HttpService,
		GuiService = GuiService,
		ReplicatedStorage = ReplicatedStorage,
	},
	helpers = {},
}

local function resolveTrident()
	local refs = getTridentBootstrap()
	local head = refs.model and refs.model:FindFirstChild("Head")

	trident.middlepart = refs.middle
	trident.bottompart = refs.bottom
	trident.toppart = refs.top
	trident.prism = refs.prism
	trident.tcp = refs.tcp
	trident.original_model = refs.model
	trident.shared = refs.shared
	trident.entities = refs.entities
	trident.player_entity = refs.playerEntity
	trident.available = refs.middle ~= nil
		and refs.tcp ~= nil
		and refs.model ~= nil
		and head ~= nil
	trident.ready = trident.available
	trident.loaded = trident.available

	return trident.available
end

-- Try immediately, then retry briefly without blocking UI construction.
resolveTrident()

task.spawn(function()
	local deadline = os.clock() + 8
	while not trident.available and os.clock() < deadline do
		resolveTrident()
		if trident.available then
			break
		end
		task.wait(0.25)
	end

	if trident.available then
		pcall(function()
			Library:Notify({
				Title = "Environment ready",
				Description = "Trident Survival references detected.",
				Time = 3,
			})
		end)
	else
	end
end)

-- ====================== GAME INTERNAL DISCOVERY ======================
local classes = nil
local garbage = {
	character = nil,
	maxlooky = nil,
	equippeditem = nil,
	entitylist = nil,
	recoil = nil,
}

local function scanGameInternals()
	if not trident.ready then
		return false
	end
	if not getgc or not getupvalue or type(debugLib) ~= "table" then
		return false
	end
	local ok, gc = pcall(getgc, true)
	if not ok or type(gc) ~= "table" then
		return false
	end
	for _, value in pairs(gc) do
		if type(value) == "table" then
			local cam = rawget(value, "Camera")
			if type(cam) == "table" and rawget(cam, "type") == "Camera" then
				classes = value
			end
			if type(rawget(value, "updateCharacter")) == "function" then
				garbage.character = rawget(value, "updateCharacter")
			end
			if type(rawget(value, "SetMaxRelativeLookExtentsY")) == "function" then
				garbage.maxlooky = rawget(value, "SetMaxRelativeLookExtentsY")
			end
			if type(rawget(value, "GetEquippedItem")) == "function" then
				garbage.equippeditem = rawget(value, "GetEquippedItem")
			end
			if type(rawget(value, "GetEntityFromPart")) == "function" then
				garbage.entitylist = rawget(value, "GetEntityFromPart")
			end
			local recoil = rawget(value, "Recoil")
			if type(recoil) == "function" and getinfo then
				local okInfo, info = pcall(getinfo, recoil)
				if okInfo and info and tostring(info.short_src):find("Camera") then
					garbage.recoil = recoil
				end
			end
		end
	end
	return garbage.entitylist ~= nil or garbage.equippeditem ~= nil
end

task.spawn(function()
	local deadline = os.clock() + 12
	local nextScan = 0
	while os.clock() < deadline and not (garbage.entitylist and garbage.equippeditem) do
		if trident.ready and os.clock() >= nextScan then
			scanGameInternals()
			nextScan = os.clock() + 1.25
		end
		task.wait(0.20)
	end
end)

